{
  "id": "avenel-test",
  "realm": "avenel",
  "displayName": "AVENEL Test Identity Provider (CI Only)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "avenel-api",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
